{
  "name": "@mypocket/app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "npm run check:design && npm run typecheck && vite build",
    "check:design": "node scripts/check-design.mjs && node scripts/check-design-docs.mjs",
    "test:design": "node --test scripts/check-design.test.mjs && node scripts/base-contract.test.mjs",
    "test:transactions": "node --test scripts/transactions.test.ts",
    "test:calendar": "node --test scripts/account-time.test.ts scripts/month-jar-logic.test.ts",
    "test:transaction-jars": "node scripts/transaction-jar.test.mjs",
    "test:transfer:integrated": "node scripts/transfer-roundtrip.mjs",
    "test:transfer:e2e": "node scripts/transfer-browser.test.mjs",
    "test:api:full": "node scripts/full-api-roundtrip.mjs",
    "test:ai": "node scripts/ai-entry.test.mjs && node scripts/ai-entry-browser.test.mjs",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host 0.0.0.0"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.35",
    "@vitejs/plugin-react": "^5.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7"
  }
}
