# Run the API from backend/; .env.local is loaded without overriding process env.
# Copy this template to .env.local, never commit real credentials.
# Local oMLX OpenAI-compatible endpoint (override for another provider).
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_MODEL=Qwen3.6-35B-A3B-MLX-4bit
AI_API_KEY=
# Persist provider token/latency usage metadata on completed AI processes.
AI_STORE_USAGE=true
# Enable fenced advisor leases/reaper only after migration 000041 is applied.
AI_ADVISOR_RUN_LEASES_ENABLED=false
# Require typed provider final answers bound to same-run evidence.
AI_ADVISOR_GROUNDING_ENABLED=false
FINANCE_ASSISTANT_URL=
FINANCE_ASSISTANT_ASSERTION_SECRET=
FINANCE_ASSISTANT_ASSERTION_SECRET_FILE=
OCR_API_URL=https://ocr.dungxbuif.com
OCR_API_KEY=
# Google OAuth (local/development only; keep real values in .env.local or the deployment secret store).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://localhost:4173/api/v1/auth/google/callback
# Native iOS Google OAuth public-client configuration; never put a client secret in the app bundle.
GOOGLE_IOS_CLIENT_ID=
GOOGLE_IOS_CLIENT_SECRET=
GOOGLE_IOS_REDIRECT_URL=mypocket://oauth/callback
# Access JWT lifetime (seconds) and rotating refresh-token lifetime (seconds).
JWT_SECRET=change-this-development-jwt-secret-32-bytes
JWT_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_SECONDS=2592000
# Private receipt storage for one-shot AI/OCR entry evidence.
S3_ENDPOINT=https://storage.dungxbuif.com
S3_REGION=
S3_BUCKET=
S3_PREFIX=mypocket/receipts
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Narrow local/dev agent credential for feedback triage and changelog publication.
FEEDBACK_AGENT_TOKEN=
# APNs token-auth transport is disabled unless explicitly enabled and all
# server-side credentials are configured. Keep the .p8 material in secrets.
APNS_ENABLED=false
APNS_TEAM_ID=
APNS_KEY_ID=
APNS_TOPIC=
APNS_PRIVATE_KEY=
APNS_ENVIRONMENT=sandbox
# Optional production source overrides for the shared 10-minute market poller.
# Defaults match the official HTML fallbacks used by the n8n gold workflow.
GOLD_BTMC_ENDPOINT=https://btmc.vn/
GOLD_BTMH_ENDPOINT=https://baotinmanhhai.vn/bang-gia-vang
