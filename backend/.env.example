# Run the API from backend/; .env.local is loaded without overriding process env.
# Copy this template to .env.local, never commit real credentials.
# Local oMLX OpenAI-compatible endpoint (override for another provider).
AI_BASE_URL=http://127.0.0.1:1234/v1
AI_MODEL=Qwen3.6-35B-A3B-MLX-4bit
AI_API_KEY=
OCR_API_URL=https://ocr.dungxbuif.com
OCR_API_KEY=
# Private receipt storage for one-shot AI/OCR entry evidence.
S3_ENDPOINT=https://storage.dungxbuif.com
S3_REGION=
S3_BUCKET=
S3_PREFIX=mypocket/receipts
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Narrow local/dev agent credential for feedback triage and changelog publication.
FEEDBACK_AGENT_TOKEN=
