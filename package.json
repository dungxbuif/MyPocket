{
  "name": "mypocket",
  "private": true,
  "workspaces": [
    "apps/web"
  ],
  "scripts": {
    "dev:api": "go run ./apps/api",
    "dev:web": "npm run dev --workspace apps/web",
    "dev:worker": "go run ./apps/worker",
    "build:web": "npm run build --workspace apps/web",
    "migrate:up": "go run ./apps/migrate",
    "test:web": "npm test --workspace apps/web -- --run",
    "test:go": "go test ./..."
  }
}
