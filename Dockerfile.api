FROM golang:1.24-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -o /out/api ./apps/api && \
    CGO_ENABLED=0 go build -o /out/worker ./apps/worker && \
    CGO_ENABLED=0 go build -o /out/migrate ./apps/migrate

FROM alpine:3.21
RUN adduser -D -H app
WORKDIR /app
COPY --from=build /out/api /app/api
COPY --from=build /out/worker /app/worker
COPY --from=build /out/migrate /app/migrate
COPY migrations /app/migrations
USER app
ENTRYPOINT ["/app/api"]
