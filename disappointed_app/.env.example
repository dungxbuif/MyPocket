APP_ENV=development
DATABASE_URL=postgres://mypocket:mypocket@127.0.0.1:55433/mypocket?sslmode=disable
PUBLIC_WEB_URL=http://127.0.0.1:5173
COOKIE_SECRET=change-this-development-cookie-secret-32-bytes
CSRF_SECRET=change-this-development-csrf-secret-32-bytes
HTTP_ADDR=:8080
DOCS_DIR=../frontend/docs/build
OAUTH_FIXTURE_MODE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=http://127.0.0.1:8080/api/v1/auth/google/callback
ALLOWED_LOGIN_EMAILS=dungbui.dungbui.00@gmail.com
API_KEY_HASH_SECRET=change-this-development-api-key-hash-secret-32-bytes
REDIS_URL=redis://127.0.0.1:6379/0
AUDIT_VIEWER_EMAIL=dungbui.dungbui.00@gmail.com
AUDIT_HASH_SECRET=change-this-development-audit-hash-32-bytes
AUDIT_RETENTION_DAYS=180
LOG_FORMAT=text
LOG_LEVEL=info
PORTFOLIO_STATIC_PRICES_JSON=
S3_ENDPOINT=http://127.0.0.1:4567
S3_BUCKET=mypocket
S3_ACCESS_KEY=test
S3_SECRET_KEY=test
AI_ENABLED=false
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT=30s
AI_MAX_RETRIES=2
OCR_ENABLED=false
OCR_BASE_URL=
OCR_API_KEY=
OCR_TIMEOUT=30s
OCR_POLL_INTERVAL=5s
OCR_MAX_PROCESSING_TIME=10m

# Production compose reads the same settings through MYPOCKET_* bindings:
# MYPOCKET_AI_ENABLED, MYPOCKET_AI_BASE_URL, MYPOCKET_AI_API_KEY,
# MYPOCKET_AI_MODEL, MYPOCKET_AI_TIMEOUT, MYPOCKET_AI_MAX_RETRIES,
# MYPOCKET_OCR_ENABLED, MYPOCKET_OCR_BASE_URL, MYPOCKET_OCR_API_KEY,
# MYPOCKET_OCR_TIMEOUT, MYPOCKET_OCR_POLL_INTERVAL,
# MYPOCKET_OCR_MAX_PROCESSING_TIME. Keep real values only in the protected
# production environment file; never commit or print them.
